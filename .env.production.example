# Release identity. Use the full approved Git commit.
PETFOOD_RELEASE_ID=replace-with-full-approved-commit
PETFOOD_EDGE_PORT=18080
PETFOOD_PUBLIC_URL=https://example.com/petfood
CORS_ALLOWED_ORIGIN=https://example.com
TRUSTED_PROXY_ADDRESSES=replace-with-host-proxy-address-or-cidr

# Explicit beta-derived durable storage. Never use a legacy volume name.
PRODUCTION_POSTGRES_VOLUME=replace-with-approved-beta-postgres-volume
PRODUCTION_REDIS_VOLUME=replace-with-approved-beta-redis-volume
PRODUCTION_RABBITMQ_VOLUME=replace-with-approved-beta-rabbitmq-volume
PRODUCTION_MINIO_VOLUME=replace-with-approved-beta-minio-volume
PRODUCTION_PHOTOS_VOLUME=replace-with-approved-beta-photos-volume

# PostgreSQL
POSTGRES_DB=replace-with-production-database
POSTGRES_USER=replace-with-production-user
POSTGRES_PASSWORD=replace-with-production-secret

# RabbitMQ
RABBITMQ_USERNAME=replace-with-production-user
RABBITMQ_PASSWORD=replace-with-production-secret

# MinIO
MINIO_ROOT_USER=replace-with-production-access-key
MINIO_ROOT_PASSWORD=replace-with-production-secret-key
PETS_MINIO_BUCKET=replace-with-production-bucket
PETS_MINIO_UPLOAD_TTL_SECONDS=300
PETS_MINIO_DOWNLOAD_TTL_SECONDS=86400

# Authentication and abuse protection
JWT_ISSUER=https://example.com/petfood
JWT_TTL_SECONDS=300
JWT_KID_TTL_SECONDS=3600
RATE_LIMIT_PEPPER=replace-with-random-production-secret
AUTH_RATE_REPLENISH_RATE=2
AUTH_RATE_BURST_CAPACITY=10
AUTH_RATE_REQUESTED_TOKENS=1

# SMTP
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_GMAIL_USER=replace-with-smtp-user
SMTP_GMAIL_PASS=replace-with-smtp-secret
SMTP_GMAIL_FROM=PetFood <noreply@example.com>
